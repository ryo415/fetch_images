# Copy this file to .env and update the values to match your accounts.
# The CLI automatically loads values exported into the environment.
# You can load them with `export $(grep -v '^#' .env | xargs)` or a dotenv tool.

# Fantia authentication
FANTIA_SESSION=
FANTIA_EMAIL=
FANTIA_PASSWORD=

# Fanbox authentication
FANBOX_SESSION=

# Enable verbose HTTP diagnostics when set to a non-empty value
FETCH_IMAGES_DEBUG=
